# ========== SERVER CONFIGURATION ==========
SERVER_PORT=8080

# ========== DATABASE CONFIGURATION ==========
# Option 1: Use separate components (recommended)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinerama_db
DB_TIMEZONE=America/Lima

# Option 2: Or use complete URL
# DB_URL=jdbc:mysql://localhost:3306/cinerama_db?useSSL=false&serverTimezone=America/Lima

DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ========== EMAIL CONFIGURATION ==========
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ========== JWT CONFIGURATION ==========
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_required
JWT_EXPIRATION=86400000

# ========== PAYPAL CONFIGURATION ==========
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ========== TMDB API CONFIGURATION ==========
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
