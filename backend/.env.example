# ========== SERVER CONFIGURATION ==========
SERVER_PORT=8080

# ========== DATABASE CONFIGURATION ==========
# Option 1: Use separate components (recommended)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinerama_db
DB_TIMEZONE=America/Lima

# Option 2: Or use complete URL
# DB_URL=jdbc:mysql://localhost:3306/cinerama_db?useSSL=false&serverTimezone=America/Lima

DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ========== EMAIL CONFIGURATION ==========
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ========== JWT CONFIGURATION ==========
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_required
JWT_EXPIRATION=86400000

# ========== PAYPAL CONFIGURATION ==========
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ========== TMDB API CONFIGURATION ==========
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ========== CORS CONFIGURATION ==========
# Comma-separated list of allowed origins
# Examples:
# - React dev: http://localhost:3000
# - Expo dev: exp://192.168.1.100:8081 (replace with your actual IP)
# - Mobile emulator: http://localhost:19006
# - Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,exp://192.168.1.100:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ========== OPTIONAL CONFIGURATION (for dev profile) ==========
# These variables have defaults in application.yml but can be overridden

# JPA Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# PayPal Mode
PAYPAL_MODE=sandbox

# Logging Configuration
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=logs/cinerama-dev.log
